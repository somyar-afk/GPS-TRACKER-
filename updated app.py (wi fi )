# Wi-Fi Trilateration Configuration & Known APs
# Format:  "aa:bb:cc:dd:ee:ff": (lat, lon)
# Place at least 3 non-collinear surveyed APs around the tracking area.
# ---------------------------------------------------------------------------
EARTH_RADIUS_M = 6_371_000.0

# "wifi_only"    -> ignore GPS completely, track via Wi-Fi only
# "wifi_primary" -> use Wi-Fi triangulation whenever >=1 known AP is seen; fall back to GPS
# "hybrid"       -> fuse GPS and Wi-Fi when both are available
LOC_MODE = os.environ.get("LOC_MODE", "wifi_primary")
if LOC_MODE not in ("wifi_only", "wifi_primary", "hybrid"):
    raise ValueError("LOC_MODE must be 'wifi_only', 'wifi_primary', or 'hybrid'")

# RF propagation calibration constants (tune on-site)
RSSI_AT_1M = float(os.environ.get("WIFI_RSSI_1M", "-42.0"))
PATH_LOSS_EXPONENT = float(os.environ.get("WIFI_PATH_LOSS", "2.8"))
MIN_WIFI_RSSI = float(os.environ.get("WIFI_MIN_RSSI", "-85.0"))

KNOWN_WIFI_APS: dict[str, tuple[float, float]] = {
    # Example IITR campus APs — replace with real BSSIDs from site survey:
    "aa:bb:cc:dd:ee:01": (29.8656, 77.8961),  # Main building AP
    "aa:bb:cc:dd:ee:02": (29.8660, 77.8970),  # Library AP
    "aa:bb:cc:dd:ee:03": (29.8650, 77.8955),  # Hostel block AP
    "aa:bb:cc:dd:ee:04": (29.8658, 77.8952),  # Lecture hall AP
}

