# ---------------------------------------------------------------------------
# Utility helpers
# ---------------------------------------------------------------------------
def _haversine(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    """Return great-circle distance in metres between two WGS-84 points."""
    phi1, phi2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlam = math.radians(lon2 - lon1)
    a = (
        math.sin(dphi / 2) ** 2
        + math.cos(phi1) * math.cos(phi2) * math.sin(dlam / 2) ** 2
    )
    return EARTH_RADIUS_M * 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a))


def _send_fcm_alert(distance_m: float, tracker_name: str | None = None) -> None:
    """Fire a high-priority FCM push to topic 'geofence_alerts' (best-effort)."""
    if not FCM_ENABLED:
        return
    if tracker_name is None:
        with lock:
            tracker_name = tracker_settings["name"]
    try:
        message = fcm_messaging.Message(
            notification=fcm_messaging.Notification(
                title=f"{tracker_name} — geofence alert",
                body=f"{tracker_name} is {distance_m:.0f} m from the safe-zone centre.",
            ),
            android=fcm_messaging.AndroidConfig(priority="high"),
            topic="geofence_alerts",
        )
        fcm_messaging.send(message)
        print(f"FCM alert sent — distance {distance_m:.1f} m")
    except Exception as exc:
        print(f"FCM send failed: {exc}")


def authorize(token: str) -> None:
    supplied = request.headers.get("Authorization", "")
    expected = "Bearer " + token
    if not hmac.compare_digest(supplied.encode(), expected.encode()):
        abort(401)


def number(data: dict, key: str, low: float, high: float, optional: bool = False):
    value = data.get(key)
    if value is None and optional:
        return None
    if (
        type(value) not in (float, int)
        or not math.isfinite(value)
        or not low <= value <= high
    ):
        abort(400, description=f"Invalid {key}")
    return value


def _rssi_to_distance_m(rssi: float) -> float:
    """Convert RSSI (dBm) to estimated distance (m) via log-distance path loss."""
    exponent = (RSSI_AT_1M - rssi) / (10.0 * PATH_LOSS_EXPONENT)
    return max(1.0, min(250.0, 10.0**exponent))


def _trilaterate_wifi(
    matched: list[tuple[str, float, float, float]],
) -> tuple[float, float, str]:
    """
    Estimate (lat, lon, loc_source) from matched APs: [(bssid, rssi, lat, lon), ...].
    Uses damped Gauss-Newton nonlinear least squares for >=3 APs,
    inverse-distance weighting for 2 APs, and AP anchor for 1 AP.
    """
    matched.sort(key=lambda item: item[1], reverse=True)

    if len(matched) == 1:
        return matched[0][2], matched[0][3], "wifi_1ap"

    points = []
    for _, rssi, lat, lon in matched[:8]:
        dist = _rssi_to_distance_m(rssi)
        weight = 1.0 / (dist**2)
        points.append((lat, lon, dist, weight))

    total_w = sum(p[3] for p in points)
    lat0 = sum(p[0] * p[3] for p in points) / total_w
    lon0 = sum(p[1] * p[3] for p in points) / total_w

    if len(points) == 2:
        return lat0, lon0, "wifi_2ap"

    # Project (lat, lon) to local planar meters relative to (lat0, lon0)
    cos_lat0 = math.cos(math.radians(lat0))
    planar = []
    for lat, lon, dist, weight in points:
        x = math.radians(lon - lon0) * cos_lat0 * EARTH_RADIUS_M
        y = math.radians(lat - lat0) * EARTH_RADIUS_M
        planar.append((x, y, dist, weight))

    # Damped Gauss-Newton iterations starting at the weighted centroid (0, 0)
    est_x, est_y = 0.0, 0.0
    damping = 1e-3

    for _ in range(20):
        jtwj_00 = jtwj_01 = jtwj_11 = damping
        jtwe_0 = jtwe_1 = 0.0

        for xi, yi, di, wi in planar:
            dx = est_x - xi
            dy = est_y - yi
            ri = math.hypot(dx, dy)
            if ri < 1e-4:
                continue
            jx = dx / ri
            jy = dy / ri
            err = ri - di

            jtwj_00 += wi * jx * jx
            jtwj_01 += wi * jx * jy
            jtwj_11 += wi * jy * jy
            jtwe_0 -= wi * jx * err
            jtwe_1 -= wi * jy * err

        det = jtwj_00 * jtwj_11 - jtwj_01 * jtwj_01
        if abs(det) < 1e-12:
            break

        step_x = (jtwj_11 * jtwe_0 - jtwj_01 * jtwe_1) / det
        step_y = (-jtwj_01 * jtwe_0 + jtwj_00 * jtwe_1) / det
        est_x += step_x
        est_y += step_y

        if math.hypot(step_x, step_y) < 0.01:
            break

    resolved_lat = lat0 + math.degrees(est_y / EARTH_RADIUS_M)
    resolved_lon = lon0 + math.degrees(est_x / (EARTH_RADIUS_M * cos_lat0))
    return resolved_lat, resolved_lon, "wifi_trilateration"


def _resolve_position(
    gps_lat: float | None,
    gps_lon: float | None,
    fix_ok: bool,
    hdop: float | None,
    wifi_aps: list | None,
) -> tuple[float | None, float | None, str]:
    """
    Resolve position using Wi-Fi trilateration and/or GPS according to LOC_MODE.

    Returns (resolved_lat, resolved_lon, loc_source)
    """
    matched: list[tuple[str, float, float, float]] = []
    if wifi_aps:
        for ap in wifi_aps:
            bssid = str(ap.get("bssid", "")).strip().lower()
            rssi = ap.get("rssi")
            if (
                isinstance(rssi, (int, float))
                and bssid in KNOWN_WIFI_APS
                and rssi >= MIN_WIFI_RSSI
            ):
                wlat, wlon = KNOWN_WIFI_APS[bssid]
                matched.append((bssid, float(rssi), wlat, wlon))

    if LOC_MODE == "wifi_only":
        if not matched:
            return None, None, "none"
        return _trilaterate_wifi(matched)

    if not matched:
        if fix_ok and gps_lat is not None and gps_lon is not None:
            return gps_lat, gps_lon, "gps"
        return None, None, "none"

    wifi_lat, wifi_lon, wifi_source = _trilaterate_wifi(matched)

    if LOC_MODE == "wifi_primary" or not fix_ok or gps_lat is None or gps_lon is None:
        return wifi_lat, wifi_lon, wifi_source

    # Hybrid fusion when both GPS and Wi-Fi are available
    poor_gps = hdop is not None and hdop > 2.0
    wifi_weight = 0.75 if (wifi_source == "wifi_trilateration" or poor_gps) else 0.40
    gps_weight = 1.0 - wifi_weight
    return (
        gps_weight * gps_lat + wifi_weight * wifi_lat,
        gps_weight * gps_lon + wifi_weight * wifi_lon,
        f"gps+{wifi_source}",
    )


